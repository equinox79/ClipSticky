<Window x:Class="ClipSticky.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipSticky"
        Width="380" Height="220"
        Topmost="True"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="#FFFDF0A8"
        AllowsTransparency="True"
        Opacity="0.96"
        ShowInTaskbar="False">
    <Border BorderBrush="#80444444" BorderThickness="1" Padding="10" Background="#FFFFF7C8">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding TitleText}" FontWeight="Bold" Margin="0,0,0,6"/>
                <ContentPresenter Content="{Binding ContentView}"/>
                <Separator Margin="0,8,0,6"/>
                <DockPanel>
                    <TextBlock Text="{Binding StatusText}" Foreground="#66333333" DockPanel.Dock="Left"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="閉じる" Margin="8,0,0,0" Padding="8,2"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
